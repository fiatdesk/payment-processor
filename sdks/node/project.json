{
  "name": "node-sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "sdks/node/src",
  "projectType": "library",
  "tags": ["scope:sdk", "type:client"],
  "implicitDependencies": ["shared-types", "shared-schemas"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npx tsx sdks/node/scripts/generate-inputs.ts && npx prettier --write sdks/node/src/generated/Inputs.ts && tsup --config sdks/node/tsup.config.ts && node sdks/node/scripts/assert-bundled-dts.mjs"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/sdks/node/*.tgz"],
      "options": {
        "command": "mkdir -p ../../dist/sdks/node && npm pack --pack-destination ../../dist/sdks/node",
        "cwd": "sdks/node"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "sdks/node/jest.config.ts"
      }
    }
  }
}

{
  "name": "@fiatdesk/source",
  "version": "0.1.0",
  "description": "Your own open-source payments platform. Accept payments, manage subscriptions, and pay sellers globally in USDC from infrastructure you control.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fiatdesk/payment-processor.git"
  },
  "homepage": "https://github.com/fiatdesk/payment-processor",
  "bugs": {
    "url": "https://github.com/fiatdesk/payment-processor/issues"
  },
  "scripts": {
    "kill": "./scripts/kill-all.sh",
    "dev": "docker compose up mongodb mongo-express -d && nx run-many -t serve -p api web --output-style=stream",
    "start:api": "nx serve api",
    "start:web": "nx serve web",
    "start:docs": "nx serve docs",
    "start:db": "docker compose up mongodb mongo-express -d",
    "prod": "docker compose --env-file .env.production up -d --build",
    "stop:db": "docker compose down",
    "build:api": "nx build api && cd dist/apps/api && npm install --package-lock-only",
    "build:cli": "nx build cli",
    "build:node": "nx build node-sdk",
    "build:web": "nx build web --configuration=production",
    "build:docs": "nx build docs --configuration=production && nx run docs:generate-md",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "lint": "npx nx run-many --target=lint --all",
    "pack:cli": "nx run cli:pack",
    "pack:node": "nx run node-sdk:pack",
    "test": "npx nx run-many --target=test --all"
  },
  "private": true,
